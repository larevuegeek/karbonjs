{
  "name": "karbonjs",
  "private": true,
  "description": "KarbonJS — Modern full-stack utilities, API helpers, and UI components",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:all": "pnpm -r publish --access public"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.2"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "simple-icons": "^16.27.1"
  }
}
